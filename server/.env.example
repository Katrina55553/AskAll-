# AskAll server config
PORT=3000
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d
# DB_PATH=./data/askall.db
# CREDENTIALS_DIR=./src/credentials

# 凭据加密主密钥（AES-256-GCM，32 字节）。
# 生成方式：openssl rand -hex 32   或   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 生产环境必须配置；开发环境未配置时自动由 JWT_SECRET 派生（不安全，仅本地用）。
# CRED_MASTER_KEY=

# Summary budget = summarizer bot contextWindow * ratio
SUMMARY_BUDGET_RATIO=0.8
MAX_SELECTED_BOTS=5
DEFAULT_SUMMARIZER_BOT=chatgpt
